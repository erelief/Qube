    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/erelief/Qube/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4MjQ0NDAwOTlCQUFCMTgKUldRWXE3cVpBRVFrbUp3eXJPK2l3L1NLMURXS3ZiS05PSEcwQTNyNFRsS3ZnRXAvc0VKbnh2clQK"
    }
  },
  "app": {
    "windows": [
      {
        "title": "Q°ube",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true
