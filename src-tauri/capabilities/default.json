{
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-save",
    "fs:default",
    "shell:allow-open",
    "updater:default",
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "$**" }]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$**" }]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$**" }]
    }
  ]
}